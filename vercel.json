{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "backend/server.cjs",
      "use": "@vercel/node",
      "config": { "maxDuration": 60 }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.wheelstowilderness.in" }],
      "status": 308,
      "headers": { "Location": "https://wheelstowilderness.in/$1" }
    },
    {
      "src": "/sitemap.xml",
      "dest": "/backend/server.cjs"
    },
    {
      "src": "/robots.txt",
      "dest": "/backend/server.cjs"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.cjs"
    },
    {
      "src": "/trip/(.*)",
      "dest": "/backend/server.cjs"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
